# Copy to .env.local and fill in. Never commit real secrets.
# MongoDB Atlas (free tier). The database user only needs readWrite on this DB.
MONGODB_ATLAS_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_ATLAS_DB_NAME=medrag
MONGODB_ATLAS_COLLECTION_NAME=chunks
MONGODB_ATLAS_SESSIONS_COLLECTION_NAME=sessions

# OpenRouter. Use free models only.
OPENROUTER_API_KEY=
CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Optional; defaults to CHAT_MODEL when omitted.
ANALYST_MODEL=
EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-8b:free
